#: ../../source/incidents-attributes.rst:701
msgid "incident:victim:names:qa"
msgstr ""

#: ../../source/incidents-attributes.rst:726
msgid "``John Smith``"
msgstr ""

#: ../../source/incidents-attributes.rst:731
msgid "This draft field provides a human readable counterpart to the :ref:`incident:victim:refs:assertion`. This field can be manually added by a researcher or automatically populated by the system after import. The best practice is to use the :ref:`name:annotation <person-name-annotation>` in this field."
msgstr ""

