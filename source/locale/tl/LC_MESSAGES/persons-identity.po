msgid "external_id"
msgstr ""

#: ../../source/persons-identity.rst:204
msgid "A number, UUID or other form of identification given to the person by an external party."
msgstr ""

#: ../../source/persons-identity.rst:209
msgid "Text string."
msgstr ""

#: ../../source/persons-identity.rst:214
msgid "This is a draft field."
